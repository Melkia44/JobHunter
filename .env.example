# France Travail API — https://francetravail.io (app avec "Offres d'emploi v2")
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Google Sheet cible (Cibles_emploi_Nantes_Mathieu)
SPREADSHEET_ID=

# Seuils de filtrage des offres (0-100) — tier-1 = employeurs cibles (relevé 50→58 le 05/07)
MIN_SCORE=65
MIN_SCORE_TIER1=58

# API Sirene (INSEE) — veille implantations. portail-api.insee.fr → souscrire « API Sirene »
INSEE_API_KEY=

# Alertes mail (boîte Gmail dédiée, IMAP + mot de passe d'application) — vides = source skippée
ALERTS_IMAP_USER=
ALERTS_IMAP_PASSWORD=
ALERTS_LOOKBACK_DAYS=3
