# France Travail API — https://francetravail.io (app avec "Offres d'emploi v2")
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Google Sheet cible : l'ID est dans l'URL, docs.google.com/spreadsheets/d/<ID>/edit
SPREADSHEET_ID=

# Seuils de filtrage des offres (0-100) — tier-1 = employeurs P1 de data/employers.yaml
MIN_SCORE=65
MIN_SCORE_TIER1=58

# Optionnel — API Sirene (INSEE), veille implantations. portail-api.insee.fr → « API Sirene »
INSEE_API_KEY=

# Optionnel — alertes mail (boîte Gmail dédiée, IMAP + mot de passe d'application)
# + ajouter email_alerts dans data/profile.yaml › sources
ALERTS_IMAP_USER=
ALERTS_IMAP_PASSWORD=
ALERTS_LOOKBACK_DAYS=3

# Optionnel — autre fichier de profil que data/profile.yaml
# PROFILE_YAML=data/profile.yaml
